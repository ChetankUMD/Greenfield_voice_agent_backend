# PostgreSQL connection string
# Local example: postgresql://localhost/greenfield
# Render: set this from your Render PostgreSQL database
DATABASE_URL=postgresql://localhost/greenfield

# Vapi credentials (leave blank to run in stub/dev mode without real calls)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_OUTBOUND_ASSISTANT_ID=

# Webhook secret — must match what you set in the Vapi dashboard
VAPI_WEBHOOK_SECRET=

# Voicemail callback number read aloud to patients
PRACTICE_CALLBACK_NUMBER=415-555-0120

# Referral retry gap in minutes (default 2880 = 48 h; set 2 for demo)
RETRY_INTERVAL_MINUTES=2880

# Server port (used by Render; locally uvicorn defaults to 8000)
PORT=8000

# Anthropic API key — required for OCR pipeline (POST /process)
ANTHROPIC_API_KEY=
